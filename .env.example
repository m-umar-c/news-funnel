PORT=3001
DATABASE_URL=postgres://funnel:funnel@localhost:5432/funnel
JWT_SECRET=change-me-before-deploying
CLIENT_ORIGIN=http://localhost:5173

# embeddings: local (MiniLM via transformers.js, no key), gemini, or hash (tests only)
EMBEDDING_PROVIDER=local
# summaries: extractive (no key) or gemini
SUMMARY_PROVIDER=extractive
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

INGEST_INTERVAL_MINUTES=20
CLUSTER_THRESHOLD=0.62
ARTICLE_MAX_AGE_DAYS=7
